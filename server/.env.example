# Port the API listens on
PORT=5000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety

# Separate database used only by `npm test` (it is wiped before every test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_test

# Secret used to sign login tokens. Use a long random string in real deployments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# bcrypt cost factor (10 is a good default)
BCRYPT_ROUNDS=10

# Time zone used to decide what "today" is for the "date cannot be in the future" rule
APP_TIMEZONE=Asia/Kolkata

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
